<service>
  <id>VMS-Proxy</id>
  <name>VMS Web &amp; Reverse Proxy Service</name>
  <description>Provides secure HTTPS web serving, LAN camera context, and unified API routing for VMS.</description>
  <executable>%BASE%\..\..\bin\proxy\caddy.exe</executable>
  <arguments>run --config "%BASE%\..\..\config\Caddyfile"</arguments>
  <workingdirectory>%BASE%\..\..\config</workingdirectory>
  <env name="VMS_INSTALL_DIR" value="%BASE%\..\.."/>
  <logpath>C:\ProgramData\VMS\logs</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>5</keepFiles>
  </log>
  <onfailure action="restart" delay="5 sec"/>
  <onfailure action="restart" delay="15 sec"/>
  <resetfailure>1 hour</resetfailure>
  <startmode>Automatic</startmode>
  <depend>VMS-Backend</depend>
</service>
